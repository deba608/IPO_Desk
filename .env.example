# ── IPO Calendar live data ───────────────────────────────────────────────
# IPO Guru developer API key. When set, the IPO Calendar and details pages
# serve LIVE data (price band, dates, GMP, subscription). When empty, the app
# falls back to curated sample data and shows a "Sample data" badge.
#
# Get a free key (no cost, manual issue) by emailing the address in the docs:
#   https://www.ipoguru.in/ipo-gmp-details-developer-api
# Limits: 15 requests/min, 300/day — results are cached server-side for 5 min.
IPOGURU_API_KEY=

# ── Database (optional — falls back to in-memory) ─────────────────────────
# PostgreSQL connection string. When set, IPO data, GMP history, reports, and
# user data are persisted. When empty, the app runs entirely in-memory.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ipodesk"

# ── Cron / sync ──────────────────────────────────────────────────────────
# Shared secret guarding the /api/cron/sync-ipos route.
CRON_SECRET=
