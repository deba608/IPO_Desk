# ── IPO Calendar live data ───────────────────────────────────────────────
# IPO Guru developer API key. When set, the IPO Calendar and details pages
# serve LIVE data (price band, dates, GMP, subscription). When empty, the app
# falls back to curated sample data and shows a "Sample data" badge.
#
# Get a free key (no cost, manual issue) by emailing the address in the docs:
#   https://www.ipoguru.in/ipo-gmp-details-developer-api
# Limits: 15 requests/min, 300/day — results are cached server-side for 5 min.
IPOGURU_API_KEY=

# ── Database (optional — falls back to in-memory) ─────────────────────────
# PostgreSQL connection string. When set, IPO data, GMP history, reports, and
# user data are persisted. When empty, the app runs entirely in-memory.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ipodesk"

# ── Cron / sync ──────────────────────────────────────────────────────────
# Shared secret guarding the /api/cron/sync-ipos route.
CRON_SECRET=

# ── Admin console ──────────────────────────────────────────────────────
# Passcode for the /admin dashboard and /api/admin/sync. Falls back to
# CRON_SECRET when empty; the endpoint refuses to run with neither set.
# Generate one with: openssl rand -hex 32
ADMIN_PASSCODE=

# ── Bigshare CAPTCHA OCR (free tier, no card) ──────────────────────────
# Key for https://api.ocr.space/parse/image (25,000 req/month free).
# Get one at https://ocr.space/ocrapi — without it the app uses the
# heavily rate-limited "helloworld" demo key.
# Set this in Vercel → Project → Settings → Environment Variables too.
OCR_SPACE_API_KEY=

# ── Postgres auth (docker-compose only) ────────────────────────────────
# POSTGRES_USER / POSTGRES_DB default to "ipodesk"; the password has no
# default and compose will refuse to start without it.
# Generate one with: openssl rand -hex 32
POSTGRES_USER=ipodesk
POSTGRES_PASSWORD=
POSTGRES_DB=ipodesk
